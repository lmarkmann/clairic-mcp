CLOUDFLARE_ACCOUNT_ID=
# Only for `just access`: an API token with Access: Apps and Policies Write.
# Not named CLOUDFLARE_API_TOKEN, so wrangler keeps using your own login to deploy.
ACCESS_API_TOKEN=
CLAIRIC_DOMAIN=clairic.example.com
ACCESS_TEAM_DOMAIN=yourteam.cloudflareaccess.com
# Comma-separated Access login emails allowed to connect
ACCESS_EMAILS=you@example.com
# Optional identity provider id; empty allows every login method the team has
ACCESS_IDP_ID=
# Written by `just access`
ACCESS_AUD=
