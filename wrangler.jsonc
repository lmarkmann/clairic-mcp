{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "clairic-mcp",
	"main": "src/index.ts",
	"compatibility_date": "2026-10-19",
	// No dependency imports node:*; the MCP SDK resolves its workerd shims.
	"compatibility_flags": ["no_nodejs_compat", "no_nodejs_compat_v2"],
	// Access fronts only the custom domain `just deploy` attaches; a workers.dev or preview URL
	// would reach the Worker without passing Access.
	"workers_dev": false,
	"preview_urls": false,
	"observability": { "enabled": true },
	// Workers AI always runs remotely, so `wrangler dev` bills the account too.
	"ai": { "binding": "AI", "remote": true },
	// Empty values reject every request. `just deploy` sets both from .env.
	"vars": {
		"ACCESS_TEAM_DOMAIN": "",
		"ACCESS_AUD": ""
	}
}
